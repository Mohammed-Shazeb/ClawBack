# Clawback environment variables.
#
# Two separate places read these:
#
#   1. Next.js reads `.env.local` (copy this file to `.env.local` and fill it in).
#   2. Convex functions read variables set on the *deployment*:
#        npx convex env set OPENAI_API_KEY "sk-..."
#      Variables in `.env.local` are NOT visible to Convex functions.
#
# Never commit real values. `.env*` is gitignored.

# --- Convex ------------------------------------------------------------------
# Written by `npx convex dev` when you link a deployment. The site URL is the
# origin that serves Convex HTTP actions (the AgentMail webhook target).
CONVEX_DEPLOYMENT=dev:your-project-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# --- OpenAI (server-side only: set on the Convex deployment) -----------------
# Any OpenAI-compatible chat completions endpoint works.
OPENAI_API_KEY=sk-replace-me
# Optional. Defaults to https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Required. The model used for statement extraction.
OPENAI_MODEL=gpt-4o-mini

# --- AgentMail (server-side only: set on the Convex deployment) --------------
# Dashboard: https://console.agentmail.to
AGENTMAIL_API_KEY=am_replace_me
# Signing secret of the webhook endpoint (starts with whsec_).
AGENTMAIL_WEBHOOK_SECRET=whsec_replace_me
# Optional. Defaults to https://api.agentmail.to/v0
AGENTMAIL_API_BASE_URL=https://api.agentmail.to/v0
# Optional. Defaults to the shared agentmail.to domain; a custom domain must be
# verified in AgentMail first.
AGENTMAIL_DOMAIN=
