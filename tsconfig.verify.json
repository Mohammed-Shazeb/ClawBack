{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "outDir": ".verify",
    "paths": {
      "@/*": ["./*"],
      "@convex-dev/auth/server": ["./node_modules/@convex-dev/auth/dist/server/index.d.ts"],
      "@convex-dev/auth/providers/*": ["./node_modules/@convex-dev/auth/dist/providers/*.d.ts"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "convex/extraction.ts",
    "convex/validators.ts",
    "convex/errors.ts",
    "convex/agentmail.ts",
    "convex/caller.ts",
    "convex/svix.ts",
    "convex/firecrawl.ts",
    "convex/questions.ts",
    "convex/assessment.ts",
    "convex/letter.ts",
    "convex/response.ts",
    "convex/send.ts",
    "convex/outbound.ts",
    "convex/responses.ts"
  ]
}
