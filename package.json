{
  "name": "clawback",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "tsc -p tsconfig.verify.json && node .verify/scripts/verify-pipeline.js",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:ui": "esbuild scripts/ui-render/entry.tsx --bundle --platform=node --format=esm --outfile=.verify/ui-render-bundle.mjs --alias:convex/react=./scripts/ui-render/stubs/convex-react.js --alias:@/convex/_generated/api=./scripts/ui-render/stubs/api.js --alias:@=./ --loader:.tsx=tsx --external:react --external:react-dom --external:react-dom/server --external:lucide-react --log-level=warning && node .verify/ui-render-bundle.mjs",
    "mocks": "node scripts/mock-providers.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "convex": "^1.45.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
