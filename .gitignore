# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# offline verification build output
/.verify/

# local workbuddy state
/.workbuddy-ai/

# local project status and verification reports
/PROJECT-STATUS.md
/SAMPLE-DEPOSIT-STATEMENT.txt
/SUBMISSION-STATUS.md
/UI-VERIFICATION.md
/VERIFICATION-REPORT.md
